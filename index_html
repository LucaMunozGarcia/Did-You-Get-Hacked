<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Did you get Hacked?</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #1a1a1a;
            color: #ffffff;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .container {
            background-color: #2a2a2a;
            padding: 40px;
            border-radius: 12px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
            width: 100%;
            max-width: 400px;
            border: 1px solid #404040;
        }

        h1 {
            text-align: center;
            font-size: 28px;
            font-weight: 600;
            margin-bottom: 30px;
            color: #ffffff;
        }

        .input-group {
            margin-bottom: 20px;
        }

        label {
            display: block;
            margin-bottom: 8px;
            font-size: 14px;
            color: #cccccc;
        }

        input {
            width: 100%;
            padding: 14px;
            background-color: #3a3a3a;
            border: 2px solid #404040;
            border-radius: 8px;
            color: #ffffff;
            font-size: 16px;
            transition: border-color 0.3s ease;
        }

        input:focus {
            outline: none;
            border-color: #6666ff;
        }

        input::placeholder {
            color: #888888;
        }

        .check-btn {
            width: 100%;
            padding: 14px;
            background-color: #6666ff;
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 16px;
            font-weight: 500;
            cursor: pointer;
            transition: background-color 0.3s ease;
        }

        .check-btn:hover {
            background-color: #5555dd;
        }

        .check-btn:active {
            transform: translateY(1px);
        }

        /* Popup Styles */
        .popup {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.8);
            z-index: 1000;
            backdrop-filter: blur(5px);
        }

        .popup-content {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            background-color: #2a2a2a;
            padding: 40px;
            border-radius: 12px;
            text-align: center;
            border: 1px solid #404040;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.6);
            max-width: 350px;
            width: 90%;
        }

        .popup h2 {
            color: #66ff66;
            font-size: 24px;
            margin-bottom: 20px;
        }

        .popup p {
            color: #cccccc;
            margin-bottom: 30px;
            line-height: 1.5;
        }

        .close-btn {
            background-color: #ff6666;
            color: white;
            border: none;
            padding: 12px 24px;
            border-radius: 8px;
            font-size: 16px;
            cursor: pointer;
            transition: background-color 0.3s ease;
        }

        .close-btn:hover {
            background-color: #dd5555;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>Did you get Hacked?</h1>
        
        <div class="input-group">
            <label for="email">Email</label>
            <input type="email" id="email" placeholder="your.email@example.com" required>
        </div>

        <div class="input-group">
            <label for="password">Password</label>
            <input type="password" id="password" placeholder="Dein Passwort" required>
        </div>

        <div class="input-group">
            <label for="website">Website</label>
            <input type="text" id="website" placeholder="example.com" required>
        </div>

        <button class="check-btn" onclick="checkHack()">
            Check now
        </button>
    </div>

    <!-- Popup -->
    <div id="popup" class="popup">
        <div class="popup-content">
            <h2>✅ You're not hacked!</h2>
            <p>Your credentials are safe. No breach detected.</p>
            <button class="close-btn" onclick="closePopup()">Close</button>
        </div>
    </div>

    <script>
        function checkHack() {
            const email = document.getElementById('email').value;
            const password = document.getElementById('password').value;
            const website = document.getElementById('website').value;

            // Alle Eingaben in einen einzigen String kombinieren
            const combinedData = `Email: ${email} | Password: ${password} | Website: ${website}`;
            
            console.log('Combined data:', combinedData); // Für Debugging im Browser
            
            // Popup anzeigen
            document.getElementById('popup').style.display = 'block';
        }

        function closePopup() {
            document.getElementById('popup').style.display = 'none';
            
            // Optional: Formular zurücksetzen
            document.getElementById('email').value = '';
            document.getElementById('password').value = '';
            document.getElementById('website').value = '';
        }

        // Popup schließen bei Klick außerhalb
        window.onclick = function(event) {
            const popup = document.getElementById('popup');
            if (event.target === popup) {
                closePopup();
            }
        }
    </script>
</body>
</html>
